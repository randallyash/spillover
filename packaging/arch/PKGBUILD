# Maintainer: randallyash
#
# Installs the released binary rather than building from source, so the package
# tracks what upstream actually published.
#
# The release artifacts are produced by cargo-dist. Before pushing, refresh the
# checksums, which cannot be known until the release exists:
#
#   updpkgsums
#
# and confirm the version and the URLs match the tag you are packaging.

pkgname=spill-bin
pkgver=0.2.0
pkgrel=1
pkgdesc="Agentic AI TUI that runs your local model first and spills over when it stalls"
arch=('x86_64' 'aarch64')
url="https://github.com/randallyash/spillover"
license=('MIT')
depends=('glibc' 'gcc-libs')
provides=('spill')
conflicts=('spill' 'spill-bin-git')
# Both of these are about shipping the released artifact unaltered rather than
# building it here: nothing is stripped, so the binary keeps the symbol table
# upstream published and its panic backtraces stay useful, and no debug package
# is made, because this recipe holds no source to debug it against. `!strip` on
# its own leaves an empty `/usr/src/debug/spill-bin` directory in the package.
options=('!strip' '!debug')

_base="https://github.com/randallyash/spillover/releases/download/v${pkgver}"
source_x86_64=("spill-${pkgver}-x86_64.tar.xz::${_base}/spill-x86_64-unknown-linux-gnu.tar.xz")
source_aarch64=("spill-${pkgver}-aarch64.tar.xz::${_base}/spill-aarch64-unknown-linux-gnu.tar.xz")

# Still the v0.1.2 sums: the 0.2.0 artifacts do not exist until the tag is pushed,
# so these are refreshed with `updpkgsums` in the commit that follows the release.
# Until then the recipe names 0.2.0 and would fail to verify, which is the one order
# these two things can be done in.
sha256sums_x86_64=('42884e95f70ddfea17bf42374bc31281b81602877d0435b0783374e1ce33d57c')
sha256sums_aarch64=('53cae3a2056e48e2469d2b691d91545de0d73d73ba7e5b0e9891d0f05650a1eb')

package() {
  # The archive holds the binary and its documentation, at the top level.
  local root
  root="$(find "$srcdir" -maxdepth 2 -type f -name spill -printf '%h\n' | head -n 1)"
  [[ -n "$root" ]] || root="$srcdir"

  install -Dm755 "$root/spill" "$pkgdir/usr/bin/spill"

  local licence
  licence="$(find "$srcdir" -maxdepth 2 -type f -name LICENSE | head -n 1)"
  if [[ -n "$licence" ]]; then
    install -Dm644 "$licence" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  fi

  local readme
  readme="$(find "$srcdir" -maxdepth 2 -type f -name README.md | head -n 1)"
  if [[ -n "$readme" ]]; then
    install -Dm644 "$readme" "$pkgdir/usr/share/doc/$pkgname/README.md"
  fi

  local changes
  changes="$(find "$srcdir" -maxdepth 2 -type f -name CHANGELOG.md | head -n 1)"
  if [[ -n "$changes" ]]; then
    install -Dm644 "$changes" "$pkgdir/usr/share/doc/$pkgname/CHANGELOG.md"
  fi
}
